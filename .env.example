# Baza danych (SQLite - plik lokalny)
DATABASE_URL="file:./dev.db"

# Sekret do podpisywania sesji panelu wlasciciela.
# W produkcji ustaw dlugi losowy ciag: openssl rand -hex 32
APP_SECRET="zmien-mnie-na-dlugi-losowy-ciag-znakow"

# Adres publiczny aplikacji - uzywany w linkach w mailach
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Powiadomienia (opcjonalne) ---
# Bez tych zmiennych maile sa tylko wypisywane w konsoli serwera.
# RESEND_API_KEY="re_..."
# MAIL_FROM="Rezerwacje <rezerwacje@twojadomena.pl>"

# Haslo do panelu operatora (/admin). Bez tej zmiennej panel jest wylaczony.
ADMIN_PASSWORD="ustaw-wlasne-haslo-operatora"

# --- SMS (opcjonalne) ---
# Bez tych zmiennych SMS-y sa tylko wypisywane w konsoli serwera.
# TWILIO_ACCOUNT_SID="AC..."
# TWILIO_AUTH_TOKEN="..."
# TWILIO_FROM="+48..."            # albo TWILIO_MESSAGING_SERVICE_SID="MG..."

# --- Zadania cykliczne ---
# Sekret chroniacy /api/cron/*. Bez niego adresy sa zamkniete.
# CRON_SECRET="dlugi-losowy-ciag"
