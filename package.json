{
  "name": "warsztat-rezerwacje",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "setup": "prisma db push --accept-data-loss && tsx prisma/seed.ts",
    "test": "tsx tests/logic.test.ts",
    "rodo:cleanup": "tsx scripts/rodo-cleanup.ts",
    "przypomnienia": "tsx scripts/przypomnienia.ts",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:backup": "tsx scripts/backup.ts",
    "db:postgres": "node scripts/provider.mjs postgresql",
    "db:sqlite": "node scripts/provider.mjs sqlite"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "next": "^15.5.23",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "prisma": "^6.19.3",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  }
